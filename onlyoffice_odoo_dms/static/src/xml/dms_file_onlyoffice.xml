<templates xml:space="preserve">

    <!-- ── Create-in-ONLYOFFICE dialog ──────────────────────────────────── -->

    <t t-name="onlyoffice_odoo_dms.DmsCreateOnlyofficeDialog">
    <Dialog title="'New ONLYOFFICE Document'" size="'lg'">
      <div class="mb-3">
        <label class="form-label fw-semibold" for="oo_dms_title">Document name</label>
        <input
          id="oo_dms_title"
          type="text"
          class="form-control"
          t-att-value="this.state.title"
          t-on-input="(ev) => this.state.title = ev.target.value"
          placeholder="Untitled"
          t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.onCreate()"
          autofocus="autofocus"
        />
      </div>
      <div class="d-flex gap-3 flex-wrap">
        <t t-foreach="this.formats" t-as="fmt" t-key="fmt.ext">
          <div
            t-att-class="'p-3 border rounded text-center cursor-pointer user-select-none ' + (this.state.format === fmt.ext ? 'border-primary bg-primary-subtle' : 'border-secondary-subtle')"
            style="min-width: 100px; flex: 1 1 100px;"
            t-on-click="() => this.state.format = fmt.ext"
          >
            <img t-att-src="`/onlyoffice_odoo_dms/static/svg/formats/${fmt.icon}`" t-att-title="fmt.label" />
            <span t-out="fmt.label" />
          </div>
        </t>
      </div>
      <t t-set-slot="footer">
        <button class="btn btn-primary" t-on-click="this.onCreate" t-att-disabled="this.state.loading || undefined">
                    <i t-if="this.state.loading" class="fa fa-spinner fa-spin me-1" />
                    Create
                </button>
        <button class="btn btn-secondary ms-2" t-on-click="this.props.close">
                    Cancel
                </button>
      </t>
    </Dialog>
  </t>

    <!-- ── Extend DMS list-view buttons: add "Create in ONLYOFFICE" ──────── -->

    <t t-name="onlyoffice_odoo_dms.ListButtonsExtension" t-inherit="dms.ListButtons">
    <xpath expr="." position="inside">
      <button
        t-if="this.ooState.canCreate"
        type="button"
        class="btn btn-secondary mx-1"
        t-on-click.prevent="this.openCreateOnlyofficeDialog"
      >
                Create in ONLYOFFICE
            </button>
    </xpath>
  </t>

    <!-- ── Extend DMS kanban-view buttons: add "Create in ONLYOFFICE" ──────── -->

    <t t-name="onlyoffice_odoo_dms.KanbanButtonsExtension" t-inherit="dms.KanbanButtons">
    <xpath expr="//div[hasclass('o_cp_buttons')]" position="inside">
      <button
        t-if="this.ooState.canCreate"
        type="button"
        class="btn btn-secondary mx-1"
        t-on-click.prevent="this.openCreateOnlyofficeDialog"
      >
                Create in ONLYOFFICE
            </button>
    </xpath>
  </t>

</templates>
